# Copy to backend/.env (used by the API, Alembic and tests) and fill in SECRET_KEY.
# docker-compose.yml has matching defaults for local development; a root .env is optional
# and only needed to override the POSTGRES_* values.

# --- Docker Compose (PostgreSQL) ---
POSTGRES_USER=invoiceflow
POSTGRES_PASSWORD=invoiceflow
POSTGRES_DB=invoiceflow
POSTGRES_PORT=5432

# --- Backend ---
ENV=development
DATABASE_URL=postgresql+psycopg://invoiceflow:invoiceflow@localhost:5432/invoiceflow
TEST_DATABASE_URL=postgresql+psycopg://invoiceflow:invoiceflow@localhost:5432/invoiceflow_test
# Required, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# --- Frontend (copy to frontend/.env) ---
VITE_API_URL=http://localhost:8000
